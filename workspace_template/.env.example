# Robot Loom workspace secrets.
#
# Copy this file to `.env` and fill in the keys you actually use.
# `.env` is auto-loaded at harness startup by robot_harness.config.loader.
# `.env` is gitignored by the workspace .gitignore — DO NOT commit it.
#
# Only set the keys for backends you use; LiteLLM picks the right one based
# on the `brain.model` prefix in config.yaml.

# --- OpenAI / OpenAI-compatible ----------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1     # override for proxies / Azure

# --- Anthropic ---------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Local Ollama ------------------------------------------------------------
# OLLAMA_API_BASE=http://localhost:11434

# --- Local vLLM (hosted_vllm/<model> in config.yaml) -------------------------
# HOSTED_VLLM_API_BASE=http://localhost:8000/v1
# HOSTED_VLLM_API_KEY=dummy                     # vLLM ignores but LiteLLM expects a value

# --- Memory / Critic / VLA external servers ---------------------------------
# ROBOT_LOOM_MEMORY_SERVER=http://localhost:7100
# ROBOT_LOOM_CRITIC_SERVER=http://localhost:7200
# ROBOT_LOOM_VLA_SERVER=http://localhost:7300

# --- Observability backends --------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
